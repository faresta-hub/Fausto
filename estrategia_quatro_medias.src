Input
  PeriodoMediaMaximas(7);
  PeriodoMediaMinimas(7);
  PeriodoMediaFechamentoCurta(10);
  PeriodoMediaFechamentoLonga(20);
  HoraInicio(1600);
  HoraFim(1700);
  HoraInicio2(0);
  HoraFim2(0);
  Quantidade(1);
  DistanciaStopPontos(100);

Var
  MediaMaximas : Float;
  MediaMinimas : Float;
  MediaCurta : Float;
  MediaLonga : Float;
  StopVenda : Float;
  StopCompra : Float;
  DentroHorario : Boolean;
  TendenciaBaixa : Boolean;
  TendenciaAlta : Boolean;
  SaidaVenda : Boolean;
  SaidaCompra : Boolean;

begin
  MediaMaximas := Media(PeriodoMediaMaximas, High);
  MediaMinimas := Media(PeriodoMediaMinimas, Low);
  MediaCurta := Media(PeriodoMediaFechamentoCurta, Close);
  MediaLonga := Media(PeriodoMediaFechamentoLonga, Close);

  DentroHorario := ((HoraInicio < HoraFim) and (Time >= HoraInicio) and (Time < HoraFim))
                   or ((HoraInicio2 < HoraFim2) and (Time >= HoraInicio2) and (Time < HoraFim2));
  TendenciaBaixa := MediaCurta < MediaLonga;
  TendenciaAlta := MediaCurta > MediaLonga;
  SaidaVenda := false;
  SaidaCompra := false;

  Plot(MediaMaximas);
  Plot2(MediaMinimas);
  Plot3(MediaCurta);
  Plot4(MediaLonga);

  if (DentroHorario = false) then
  begin
    CancelPendingOrders;

    if (HasPosition = true) then
      ClosePosition;

    PaintBar(clSilver);
  end
  else if IsSold then
  begin
    StopVenda := SellPrice + DistanciaStopPontos;
    SaidaVenda := (Low <= MediaMinimas) or (High >= StopVenda);

    if SaidaVenda then
      BuyToCoverAtMarket(Quantidade);

    PaintBar(clRed);
  end
  else if IsBought then
  begin
    StopCompra := BuyPrice - DistanciaStopPontos;
    SaidaCompra := (High >= MediaMaximas) or (Low <= StopCompra);

    if SaidaCompra then
      SellAtMarket(Quantidade);

    PaintBar(clGreen);
  end
  else
  begin
    if TendenciaBaixa and (Close > MediaMaximas) then
    begin
      SellShortAtMarket(Quantidade);
      PaintBar(clMaroon);
    end
    else if TendenciaAlta and (Close < MediaMinimas) then
    begin
      BuyAtMarket(Quantidade);
      PaintBar(clLime);
    end;
  end;
end;
