Input
  AlvoPontos(50);
  QuantidadeInicial(1);
  MaxViradas(3);
  HoraInicio(900);
  HoraFimSinais(930);

Var
  // Leituras posicionais: capturadas aqui, NUNCA dentro de condicionais
  cOpen  : Float;
  cClose : Float;
  cHigh  : Float;
  cLow   : Float;
  cTime  : Integer;

  // Controle de dia e barra
  diaRef  : Integer;
  barProc : Integer;

  // Posicao anterior e atual (inteiro: 1=comprado, -1=vendido, 0=flat)
  posAtual : Integer;
  posAnt   : Integer;

  // Parametros do trade em andamento
  qtd     : Integer;
  viradas : Integer;
  dir     : Integer;
  nivStop : Float;
  nivAlvo : Float;

  // Maquina de estados (apenas um ativo por vez):
  //   ordemPosta  : stop de entrada colocado, aguardando acionamento
  //   naPos       : posicao aberta, ordem de alvo ativa
  //   revertendo  : ClosePosition chamado para reversao; aguarda fechamento para armar novo stop
  //   encerrando  : ClosePosition chamado por limite de viradas; aguarda fechamento para encerrar
  //   encerrado   : dia encerrado, nenhuma ordem mais
  ordemPosta : Boolean;
  naPos      : Boolean;
  revertendo : Boolean;
  encerrando : Boolean;
  encerrado  : Boolean;

begin
  // --- Captura posicional obrigatoria antes de qualquer condicional ---
  cOpen  := Open[1];
  cClose := Close[1];
  cHigh  := High[1];
  cLow   := Low[1];
  cTime  := Time[1];

  // --- Reset no inicio de cada novo dia ---
  if Date <> diaRef then
  begin
    diaRef     := Date;
    barProc    := CurrentBar;
    qtd        := QuantidadeInicial;
    viradas    := 0;
    dir        := 0;
    nivStop    := 0;
    nivAlvo    := 0;
    ordemPosta := false;
    naPos      := false;
    revertendo := false;
    encerrando := false;
    encerrado  := false;
    posAnt     := 0;
    CancelPendingOrders;
    if HasPosition then
      ClosePosition;
  end;

  // --- Posicao neste tick ---
  posAtual := 0;
  if IsBought then
    posAtual := 1
  else if IsSold then
    posAtual := -1;

  // --- Transicao flat -> posicionado (stop de entrada acionado) ---
  if ordemPosta and (posAnt = 0) and (posAtual <> 0) then
  begin
    ordemPosta := false;
    naPos      := true;
    dir        := posAtual;
    if posAtual = 1 then
      nivAlvo := BuyPrice + AlvoPontos
    else
      nivAlvo := SellPrice - AlvoPontos;
  end;

  // --- Transicao posicionado -> flat ---
  if naPos and (posAnt <> 0) and (posAtual = 0) then
  begin
    naPos   := false;
    nivAlvo := 0;
    if revertendo then
    begin
      // Fechou para reversao: arma novo stop
      revertendo := false;
      ordemPosta := true;
    end
    else if encerrando then
    begin
      // Fechou por limite de viradas: encerra o dia
      encerrando := false;
      encerrado  := true;
    end
    else
    begin
      // Fechou pelo alvo: encerra o dia
      encerrado := true;
    end;
  end;

  // --- Processamento do candle fechado ---
  if (CurrentBar > 1) and (CurrentBar <> barProc) and (cTime >= HoraInicio) then
  begin
    barProc := CurrentBar;

    // Se flat e sem transicao pendente: cancela ordem anterior nao acionada
    if (not naPos) and (not revertendo) and (not encerrando) then
    begin
      if ordemPosta then
      begin
        CancelPendingOrders;
        ordemPosta := false;
      end;
    end;

    // Reversao: em posicao ativa, sem fechamento em andamento
    if naPos and (not revertendo) and (not encerrando) then
    begin
      if (dir = 1) and (cClose < cOpen) then
      begin
        // Comprado + candle baixista: reverter para vendido
        CancelPendingOrders;
        ClosePosition;
        if viradas < MaxViradas then
        begin
          viradas    := viradas + 1;
          qtd        := qtd * 2;
          dir        := -1;
          nivStop    := cLow;
          revertendo := true;
        end
        else
          encerrando := true;
      end
      else if (dir = -1) and (cClose > cOpen) then
      begin
        // Vendido + candle altista: reverter para comprado
        CancelPendingOrders;
        ClosePosition;
        if viradas < MaxViradas then
        begin
          viradas    := viradas + 1;
          qtd        := qtd * 2;
          dir        := 1;
          nivStop    := cHigh;
          revertendo := true;
        end
        else
          encerrando := true;
      end;
    end;

    // Novo sinal de entrada inicial
    if (not naPos) and (not ordemPosta) and (not revertendo) and
       (not encerrado) and (not encerrando) and (cTime < HoraFimSinais) then
    begin
      if cClose > cOpen then
      begin
        dir        := 1;
        nivStop    := cHigh;
        ordemPosta := true;
      end
      else if cClose < cOpen then
      begin
        dir        := -1;
        nivStop    := cLow;
        ordemPosta := true;
      end;
    end;
  end;

  // --- Gestao de ordens a cada tick ---
  if encerrado or encerrando or revertendo then
    CancelPendingOrders
  else if naPos and (nivAlvo <> 0) then
  begin
    CancelPendingOrders;
    if dir = 1 then
      SellShortLimit(nivAlvo, qtd)
    else
      BuyToCoverLimit(nivAlvo, qtd);
  end
  else if ordemPosta then
  begin
    CancelPendingOrders;
    if dir = 1 then
      BuyStop(nivStop, qtd)
    else
      SellShortStop(nivStop, qtd);
  end;

  posAnt := posAtual;
end;
