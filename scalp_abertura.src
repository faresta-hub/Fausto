// Estrategia: entrada unica no primeiro candle do dia.
// Primeiro candle positivo -> BuyStop na maxima.
// Primeiro candle negativo -> SellShortStop na minima.
// Saida pelo alvo ou no fechamento do primeiro candle de direcao oposta.
//
// Cada ordem e colocada UMA UNICA VEZ por dia (flags stopOk/alvoOk)
// para evitar acumulo de ordens multiplas por tick.

Input
  AlvoPontos(50);
  Quantidade(1);
  HoraInicio(900);

Var
  // Leituras posicionais: sempre no topo, nunca dentro de condicionais
  cOpen  : Float;
  cClose : Float;
  cHigh  : Float;
  cLow   : Float;
  cTime  : Integer;

  // Controle diario
  diaRef       : Integer;
  dirDia       : Integer;   // 0=aguardando 1=compra -1=venda 999=encerrado
  nivStop      : Float;
  nivAlvo      : Float;

  // Flags de ordem: cada ordem colocada no maximo uma vez por dia
  stopOk       : Boolean;
  alvoOk       : Boolean;
  diaEncerrado : Boolean;

  // Controle de posicao para detectar fechamento
  barEntrada   : Integer;
  estavaNaPos  : Boolean;

begin
  // --- Captura posicional obrigatoria no topo ---
  cOpen  := Open[1];
  cClose := Close[1];
  cHigh  := High[1];
  cLow   := Low[1];
  cTime  := Time[1];

  // --- Reset diario ---
  if Date <> diaRef then
  begin
    diaRef       := Date;
    dirDia       := 0;
    nivStop      := 0;
    nivAlvo      := 0;
    stopOk       := false;
    alvoOk       := false;
    diaEncerrado := false;
    barEntrada   := 0;
    estavaNaPos  := false;
    CancelPendingOrders;
    if HasPosition then
      ClosePosition;
  end;

  // --- Detectar trade encerrado (estava em posicao e agora esta flat) ---
  if estavaNaPos and (not HasPosition) then
    diaEncerrado := true;

  if HasPosition then
  begin
    estavaNaPos := true;
    if barEntrada = 0 then
      barEntrada := CurrentBar;
  end;

  // --- Determinar direcao pelo primeiro candle (executa uma vez) ---
  if (dirDia = 0) and (cTime = HoraInicio) then
  begin
    if cClose > cOpen then
    begin
      dirDia  := 1;
      nivStop := cHigh;
    end
    else if cClose < cOpen then
    begin
      dirDia  := -1;
      nivStop := cLow;
    end
    else
      diaEncerrado := true;
  end;

  // --- Saida por candle de direcao oposta ---
  // Verifica somente em barras apos a entrada para evitar falso gatilho
  // causado pelo candle anterior ao acionamento do stop
  if (not diaEncerrado) and (barEntrada > 0) and (CurrentBar > barEntrada) then
  begin
    if IsBought and (cClose < cOpen) then
    begin
      CancelPendingOrders;
      ClosePosition;
      diaEncerrado := true;
    end;
    if IsSold and (cClose > cOpen) then
    begin
      CancelPendingOrders;
      ClosePosition;
      diaEncerrado := true;
    end;
  end;

  // --- Colocar stop de entrada UMA UNICA VEZ ---
  if (not diaEncerrado) and (not stopOk) and (not HasPosition) then
  begin
    if dirDia = 1 then
    begin
      BuyStop(nivStop, Quantidade);
      stopOk := true;
    end
    else if dirDia = -1 then
    begin
      SellShortStop(nivStop, Quantidade);
      stopOk := true;
    end;
  end;

  // --- Colocar alvo UMA UNICA VEZ quando em posicao ---
  if (not diaEncerrado) and (not alvoOk) then
  begin
    if IsBought and (BuyPrice > 0) then
    begin
      nivAlvo := BuyPrice + AlvoPontos;
      SellShortLimit(nivAlvo, Quantidade);
      alvoOk := true;
    end
    else if IsSold and (SellPrice > 0) then
    begin
      nivAlvo := SellPrice - AlvoPontos;
      BuyToCoverLimit(nivAlvo, Quantidade);
      alvoOk := true;
    end;
  end;

end;
