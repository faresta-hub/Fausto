// scalp_abertura.src
// Entra UMA VEZ no primeiro candle com time = HoraInicio.
// Candle de alta -> BuyStop na maxima. Candle de baixa -> SellShortStop na minima.
// Saida: alvo em AlvoPontos ou primeiro candle de direcao oposta.

Input
  AlvoPontos(50);
  Quantidade(1);
  HoraInicio(900);

Var
  // Posicionais: sempre no topo, nunca em escopos condicionais
  cOpen  : Float;
  cClose : Float;
  cHigh  : Float;
  cLow   : Float;
  cTime  : Integer;

  diaRef     : Integer;
  dirDia     : Integer;   // 0=aguardando  1=compra  -1=venda
  nivStop    : Float;
  nivAlvo    : Float;
  entrou     : Boolean;
  barEntrada : Integer;
  encerrado  : Boolean;

begin
  cOpen  := Open[1];
  cClose := Close[1];
  cHigh  := High[1];
  cLow   := Low[1];
  cTime  := Time[1];

  // Reset diario
  if Date <> diaRef then
  begin
    diaRef     := Date;
    dirDia     := 0;
    nivStop    := 0;
    nivAlvo    := 0;
    entrou     := false;
    barEntrada := 0;
    encerrado  := false;
    CancelPendingOrders;
    if HasPosition then
      ClosePosition;
  end;

  // Detectar direcao no primeiro candle do dia
  if (dirDia = 0) and (cTime = HoraInicio) then
  begin
    if cClose > cOpen then begin dirDia := 1;  nivStop := cHigh; end
    else if cClose < cOpen then begin dirDia := -1; nivStop := cLow;  end
    else encerrado := true;
  end;

  // Detectar entrada (stop acionado)
  if (not entrou) and HasPosition then
  begin
    entrou     := true;
    barEntrada := CurrentBar;
    if IsBought then nivAlvo := BuyPrice + AlvoPontos
    else if IsSold then nivAlvo := SellPrice - AlvoPontos;
  end;

  // Detectar saida por alvo ou stop externo
  if entrou and (not HasPosition) then
    encerrado := true;

  // Saida por candle de direcao oposta (somente apos a barra de entrada)
  if entrou and HasPosition and (CurrentBar > barEntrada) then
  begin
    if (IsBought and (cClose < cOpen)) or (IsSold and (cClose > cOpen)) then
    begin
      CancelPendingOrders;
      ClosePosition;
      encerrado := true;
    end;
  end;

  // Gestao de ordens: cancel + resubmit a cada tick (padrao NTSL)
  if encerrado then
    CancelPendingOrders
  else if entrou and HasPosition then
  begin
    CancelPendingOrders;
    if IsBought then SellShortLimit(nivAlvo, Quantidade)
    else if IsSold then BuyToCoverLimit(nivAlvo, Quantidade);
  end
  else if dirDia = 1 then
  begin
    CancelPendingOrders;
    BuyStop(nivStop, Quantidade);
  end
  else if dirDia = -1 then
  begin
    CancelPendingOrders;
    SellShortStop(nivStop, Quantidade);
  end;

end;
