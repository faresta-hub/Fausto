// scalp_abertura.src
// Entra no primeiro candle apos HoraInicio (uma unica entrada por dia).
// Saida pelo alvo (AlvoPontos) ou pelo primeiro candle de direcao oposta.
//
// Segue exatamente o padrao do scalp_reversao_alvo.src:
//   - PosicaoAnterior para detectar transicoes de posicao
//   - CancelPendingOrders + re-submit a cada tick (ordens NTSL nao sao persistentes)
//   - UltimoCandleProcessado para executar logica de candle uma unica vez por barra

Input
  AlvoPontos(50);
  Quantidade(1);
  HoraInicio(900);

Var
  // Posicionais capturados no topo - evita warning de acesso em escopo condicional
  cOpen  : Float;
  cClose : Float;
  cHigh  : Float;
  cLow   : Float;
  cTime  : Integer;

  DataReferencia         : Integer;
  UltimoCandleProcessado : Integer;
  NivelDisparo           : Float;
  PrecoAlvo              : Float;
  DirecaoOrdem           : Integer;
  PosicaoAtual           : Integer;
  PosicaoAnterior        : Integer;
  OrdemArmada            : Boolean;
  AlvoAtingidoNoDia      : Boolean;
  FechamentoPorReversao  : Boolean;
  PrimeiroCandleFeito    : Boolean;

begin
  // Posicionais no topo - obrigatorio para evitar comportamento indefinido
  cOpen  := Open[1];
  cClose := Close[1];
  cHigh  := High[1];
  cLow   := Low[1];
  cTime  := Time[1];

  // --- Estado da posicao no inicio do tick ---
  PosicaoAtual := 0;
  if IsBought then
    PosicaoAtual := 1
  else if IsSold then
    PosicaoAtual := -1;

  // --- Reset diario ---
  if Date <> DataReferencia then
  begin
    DataReferencia         := Date;
    UltimoCandleProcessado := CurrentBar;
    NivelDisparo           := 0;
    PrecoAlvo              := 0;
    DirecaoOrdem           := 0;
    PosicaoAnterior        := PosicaoAtual;
    OrdemArmada            := false;
    AlvoAtingidoNoDia      := false;
    FechamentoPorReversao  := false;
    PrimeiroCandleFeito    := false;
    CancelPendingOrders;
    if HasPosition then
      ClosePosition;
  end;

  // --- Transicao: sem posicao -> com posicao (stop de entrada acionado) ---
  if OrdemArmada and (PosicaoAnterior = 0) and (PosicaoAtual <> 0) then
  begin
    OrdemArmada := false;
    if IsBought then
      PrecoAlvo := BuyPrice + AlvoPontos
    else if IsSold then
      PrecoAlvo := SellPrice - AlvoPontos;
  end;

  // --- Transicao: com posicao -> zerou ---
  if (PosicaoAnterior <> 0) and (PosicaoAtual = 0) then
  begin
    if (PrecoAlvo <> 0) and (not FechamentoPorReversao) then
      AlvoAtingidoNoDia := true;
    PrecoAlvo             := 0;
    FechamentoPorReversao := false;
    OrdemArmada           := false;
  end;

  // --- Processar novo candle (uma vez por candle) ---
  if (not AlvoAtingidoNoDia) and (CurrentBar > 1) and (CurrentBar <> UltimoCandleProcessado) then
  begin
    UltimoCandleProcessado := CurrentBar;

    // Primeira entrada do dia: armar stop no primeiro candle >= HoraInicio
    if (not PrimeiroCandleFeito) and (cTime >= HoraInicio) then
    begin
      PrimeiroCandleFeito := true;
      if cClose > cOpen then
      begin
        DirecaoOrdem := 1;
        NivelDisparo := cHigh;
        OrdemArmada  := true;
      end
      else if cClose < cOpen then
      begin
        DirecaoOrdem := -1;
        NivelDisparo := cLow;
        OrdemArmada  := true;
      end;
      // Doji: nao opera no dia
    end;

    // Em posicao: saida por candle de direcao oposta
    if HasPosition then
    begin
      if IsBought and (cClose < cOpen) then
      begin
        FechamentoPorReversao := true;
        ClosePosition;
        PrecoAlvo         := 0;
        OrdemArmada       := false;
        AlvoAtingidoNoDia := true;
      end
      else if IsSold and (cClose > cOpen) then
      begin
        FechamentoPorReversao := true;
        ClosePosition;
        PrecoAlvo         := 0;
        OrdemArmada       := false;
        AlvoAtingidoNoDia := true;
      end;
    end;
  end;

  // --- Gestao de ordens (re-submit a cada tick - padrao NTSL) ---
  if AlvoAtingidoNoDia then
  begin
    CancelPendingOrders;
    OrdemArmada := false;
  end
  else if HasPosition and (PrecoAlvo <> 0) then
  begin
    CancelPendingOrders;
    if IsBought then
      SellShortLimit(PrecoAlvo, Quantidade)
    else if IsSold then
      BuyToCoverLimit(PrecoAlvo, Quantidade);
  end
  else if OrdemArmada then
  begin
    CancelPendingOrders;
    if DirecaoOrdem = 1 then
      BuyStop(NivelDisparo, Quantidade)
    else if DirecaoOrdem = -1 then
      SellShortStop(NivelDisparo, Quantidade);
  end;

  // --- Salvar estado para o proximo tick ---
  PosicaoAnterior := PosicaoAtual;
end;
