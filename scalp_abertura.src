Input
  AlvoPontos(50);
  Quantidade(1);
  HoraInicio(900);

Var
  // Leituras posicionais: capturadas aqui, NUNCA dentro de condicionais
  cOpen  : Float;
  cClose : Float;
  cHigh  : Float;
  cLow   : Float;
  cTime  : Integer;

  // Controle de dia e barra
  diaRef  : Integer;
  barProc : Integer;

  // Posicao anterior e atual (1=comprado, -1=vendido, 0=flat)
  posAtual : Integer;
  posAnt   : Integer;

  // Dados do trade
  dirEntrada : Integer;
  nivStop    : Float;
  nivAlvo    : Float;

  // Maquina de estados:
  //   aguardando : esperando o primeiro candle fechar
  //   stopArmado : stop de entrada colocado, aguardando acionamento
  //   naPos      : em posicao, ordem de alvo ativa
  //   fechando   : ClosePosition chamado por candle contrario; aguarda flat
  //   encerrado  : dia encerrado
  aguardando : Boolean;
  stopArmado : Boolean;
  naPos      : Boolean;
  fechando   : Boolean;
  encerrado  : Boolean;

begin
  // --- Captura posicional obrigatoria antes de qualquer condicional ---
  cOpen  := Open[1];
  cClose := Close[1];
  cHigh  := High[1];
  cLow   := Low[1];
  cTime  := Time[1];

  // --- Reset no inicio de cada novo dia ---
  if Date <> diaRef then
  begin
    diaRef     := Date;
    barProc    := CurrentBar;
    dirEntrada := 0;
    nivStop    := 0;
    nivAlvo    := 0;
    aguardando := true;
    stopArmado := false;
    naPos      := false;
    fechando   := false;
    encerrado  := false;
    posAnt     := 0;
    CancelPendingOrders;
    if HasPosition then
      ClosePosition;
  end;

  // --- Posicao neste tick ---
  posAtual := 0;
  if IsBought then
    posAtual := 1
  else if IsSold then
    posAtual := -1;

  // --- Transicao flat -> posicionado (stop de entrada acionado) ---
  if stopArmado and (posAnt = 0) and (posAtual <> 0) then
  begin
    stopArmado := false;
    naPos      := true;
    dirEntrada := posAtual;
    if posAtual = 1 then
      nivAlvo := BuyPrice + AlvoPontos
    else
      nivAlvo := SellPrice - AlvoPontos;
  end;

  // --- Transicao posicionado -> flat (alvo ou candle contrario) ---
  if (naPos or fechando) and (posAnt <> 0) and (posAtual = 0) then
  begin
    naPos      := false;
    fechando   := false;
    nivAlvo    := 0;
    encerrado  := true;
  end;

  // --- Processamento do candle fechado ---
  if (CurrentBar > 1) and (CurrentBar <> barProc) then
  begin
    barProc := CurrentBar;

    // Primeiro candle do dia: armar stop de entrada
    if aguardando and (cTime >= HoraInicio) then
    begin
      aguardando := false;
      if cClose > cOpen then
      begin
        dirEntrada := 1;
        nivStop    := cHigh;
        stopArmado := true;
      end
      else if cClose < cOpen then
      begin
        dirEntrada := -1;
        nivStop    := cLow;
        stopArmado := true;
      end
      else
        encerrado := true;
    end;

    // Em posicao: verificar candle de direcao oposta
    if naPos and (not fechando) then
    begin
      if (dirEntrada = 1) and (cClose < cOpen) then
      begin
        CancelPendingOrders;
        ClosePosition;
        fechando := true;
        naPos    := false;
      end
      else if (dirEntrada = -1) and (cClose > cOpen) then
      begin
        CancelPendingOrders;
        ClosePosition;
        fechando := true;
        naPos    := false;
      end;
    end;
  end;

  // --- Gestao de ordens a cada tick ---
  if encerrado or fechando then
    CancelPendingOrders
  else if naPos and (nivAlvo <> 0) then
  begin
    CancelPendingOrders;
    if dirEntrada = 1 then
      SellShortLimit(nivAlvo, Quantidade)
    else
      BuyToCoverLimit(nivAlvo, Quantidade);
  end
  else if stopArmado then
  begin
    CancelPendingOrders;
    if dirEntrada = 1 then
      BuyStop(nivStop, Quantidade)
    else
      SellShortStop(nivStop, Quantidade);
  end;

  posAnt := posAtual;
end;
