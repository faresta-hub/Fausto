Input
  AlvoPontos(50);
  Quantidade(1);

Var
  UltimoCandleProcessado : Integer;
  DirecaoCandle : Integer;
  NivelEntrada : Float;
  AlvoAtual : Float;
  PosicaoAtual : Integer;
  PosicaoAnterior : Integer;

begin
  PosicaoAtual := 0;

  if IsBought then
    PosicaoAtual := 1
  else if IsSold then
    PosicaoAtual := -1;

  if (PosicaoAnterior <> 0) and (PosicaoAtual = 0) then
  begin
    DirecaoCandle := 0;
    NivelEntrada := 0;
    AlvoAtual := 0;
  end;

  if (CurrentBar > 1) and (CurrentBar <> UltimoCandleProcessado) then
  begin
    UltimoCandleProcessado := CurrentBar;

    if not HasPosition then
    begin
      CancelPendingOrders;
      DirecaoCandle := 0;
      NivelEntrada := 0;

      if (Close[1] > Open[1]) then
      begin
        DirecaoCandle := 1;
        NivelEntrada := High[1];
      end
      else if (Close[1] < Open[1]) then
      begin
        DirecaoCandle := -1;
        NivelEntrada := Low[1];
      end;
    end;
  end;

  if IsBought then
  begin
    AlvoAtual := BuyPrice + AlvoPontos;
    CancelPendingOrders;
    SellShortLimit(AlvoAtual, Quantidade);
  end
  else if IsSold then
  begin
    AlvoAtual := SellPrice - AlvoPontos;
    CancelPendingOrders;
    BuyToCoverLimit(AlvoAtual, Quantidade);
  end
  else if (NivelEntrada <> 0) then
  begin
    CancelPendingOrders;

    if (DirecaoCandle = 1) then
      BuyStop(NivelEntrada, Quantidade)
    else if (DirecaoCandle = -1) then
      SellShortStop(NivelEntrada, Quantidade);
  end;

  PosicaoAnterior := PosicaoAtual;
end;
