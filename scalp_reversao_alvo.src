Input
  AlvoPontos(50);
  QuantidadeInicial(1);

Var
  DataReferencia : Integer;
  UltimoCandleProcessado : Integer;
  CandleDirecao : Integer;
  QuantidadeAtual : Integer;
  QuantidadeProximaPosicao : Integer;
  NivelDisparo : Float;
  PrecoAlvo : Float;
  DirecaoOrdem : Integer;
  PosicaoAtual : Integer;
  PosicaoAnterior : Integer;
  OrdemArmada : Boolean;
  AlvoAtingidoNoDia : Boolean;

begin
  PosicaoAtual := 0;

  if IsBought then
    PosicaoAtual := 1
  else if IsSold then
    PosicaoAtual := -1;

  if (Date <> DataReferencia) then
  begin
    DataReferencia := Date;
    UltimoCandleProcessado := -1;
    CandleDirecao := 0;
    QuantidadeAtual := QuantidadeInicial;
    QuantidadeProximaPosicao := QuantidadeInicial;
    NivelDisparo := 0;
    PrecoAlvo := 0;
    DirecaoOrdem := 0;
    PosicaoAtual := 0;
    PosicaoAnterior := 0;
    OrdemArmada := false;
    AlvoAtingidoNoDia := false;

    CancelPendingOrders;

    if (HasPosition = true) then
      ClosePosition;
  end;

  if (PosicaoAtual <> PosicaoAnterior) then
  begin
    if (PosicaoAtual <> 0) then
    begin
      QuantidadeAtual := QuantidadeProximaPosicao;

      if (PosicaoAtual = 1) then
        PrecoAlvo := NivelDisparo + AlvoPontos
      else
        PrecoAlvo := NivelDisparo - AlvoPontos;

      OrdemArmada := false;
    end
    else if (PosicaoAnterior <> 0) and (AlvoAtingidoNoDia = false) then
    begin
      AlvoAtingidoNoDia := true;
      OrdemArmada := false;
      NivelDisparo := 0;
      PrecoAlvo := 0;
      CancelPendingOrders;
    end;

    PosicaoAnterior := PosicaoAtual;
  end;

  if (AlvoAtingidoNoDia = false) and (CurrentBar > 1) and (CurrentBar <> UltimoCandleProcessado) then
  begin
    UltimoCandleProcessado := CurrentBar;
    CandleDirecao := 0;

    if (Close[1] > Open[1]) then
      CandleDirecao := 1
    else if (Close[1] < Open[1]) then
      CandleDirecao := -1;

    if (PosicaoAtual = 0) then
    begin
      OrdemArmada := false;

      if (CandleDirecao = 1) then
      begin
        DirecaoOrdem := 1;
        NivelDisparo := High[1];
        QuantidadeProximaPosicao := QuantidadeAtual;
        OrdemArmada := true;
      end
      else if (CandleDirecao = -1) then
      begin
        DirecaoOrdem := -1;
        NivelDisparo := Low[1];
        QuantidadeProximaPosicao := QuantidadeAtual;
        OrdemArmada := true;
      end;
    end
    else if (PosicaoAtual = 1) and (CandleDirecao = -1) then
    begin
      DirecaoOrdem := -1;
      NivelDisparo := Low[1];
      QuantidadeProximaPosicao := QuantidadeAtual * 2;
      OrdemArmada := true;
    end
    else if (PosicaoAtual = -1) and (CandleDirecao = 1) then
    begin
      DirecaoOrdem := 1;
      NivelDisparo := High[1];
      QuantidadeProximaPosicao := QuantidadeAtual * 2;
      OrdemArmada := true;
    end;
  end;

  if AlvoAtingidoNoDia then
  begin
    CancelPendingOrders;
  end
  else
  begin
    CancelPendingOrders;

    if (PosicaoAtual = 1) then
    begin
      SellLimit(QuantidadeAtual, PrecoAlvo);

      if OrdemArmada and (DirecaoOrdem = -1) then
        SellShortStop(QuantidadeAtual + QuantidadeProximaPosicao, NivelDisparo);
    end
    else if (PosicaoAtual = -1) then
    begin
      BuyToCoverLimit(QuantidadeAtual, PrecoAlvo);

      if OrdemArmada and (DirecaoOrdem = 1) then
        BuyStop(QuantidadeAtual + QuantidadeProximaPosicao, NivelDisparo);
    end
    else if OrdemArmada then
    begin
      if (DirecaoOrdem = 1) then
        BuyStop(QuantidadeProximaPosicao, NivelDisparo)
      else if (DirecaoOrdem = -1) then
        SellShortStop(QuantidadeProximaPosicao, NivelDisparo);
    end;
  end;
end;
