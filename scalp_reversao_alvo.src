Input
  AlvoPontos(50);
  QuantidadeInicial(1);

Var
  DataReferencia : Integer;
  UltimoCandleProcessado : Integer;
  CandleDirecao : Integer;
  QuantidadeAtual : Integer;
  NivelDisparo : Float;
  PrecoAlvo : Float;
  DirecaoOrdem : Integer;
  OrdemArmada : Boolean;
  AlvoAtingidoNoDia : Boolean;

begin
  if (Date <> DataReferencia) then
  begin
    DataReferencia := Date;
    UltimoCandleProcessado := -1;
    CandleDirecao := 0;
    QuantidadeAtual := QuantidadeInicial;
    NivelDisparo := 0;
    PrecoAlvo := 0;
    DirecaoOrdem := 0;
    OrdemArmada := false;
    AlvoAtingidoNoDia := false;

    CancelPendingOrders;

    if (HasPosition = true) then
      ClosePosition;
  end;

  if IsBought and (PrecoAlvo > 0) and (High >= PrecoAlvo) then
  begin
    SellAtMarket(QuantidadeAtual);
    AlvoAtingidoNoDia := true;
    OrdemArmada := false;
    NivelDisparo := 0;
    PrecoAlvo := 0;
    CancelPendingOrders;
  end
  else if IsSold and (PrecoAlvo > 0) and (Low <= PrecoAlvo) then
  begin
    BuyToCoverAtMarket(QuantidadeAtual);
    AlvoAtingidoNoDia := true;
    OrdemArmada := false;
    NivelDisparo := 0;
    PrecoAlvo := 0;
    CancelPendingOrders;
  end;

  if (AlvoAtingidoNoDia = false) and (CurrentBar > 1) and (CurrentBar <> UltimoCandleProcessado) then
  begin
    UltimoCandleProcessado := CurrentBar;
    CandleDirecao := 0;

    if (HasPosition = false) then
    begin
      CancelPendingOrders;
      OrdemArmada := false;
    end;

    if (Close[1] > Open[1]) then
      CandleDirecao := 1
    else if (Close[1] < Open[1]) then
      CandleDirecao := -1;

    if (CandleDirecao <> 0) then
    begin
      if IsBought and (CandleDirecao = -1) then
      begin
        ClosePosition;
        PrecoAlvo := 0;
        DirecaoOrdem := -1;
        NivelDisparo := Low[1];
        OrdemArmada := true;
      end
      else if IsSold and (CandleDirecao = 1) then
      begin
        ClosePosition;
        PrecoAlvo := 0;
        DirecaoOrdem := 1;
        NivelDisparo := High[1];
        OrdemArmada := true;
      end;

      if (HasPosition = false) then
      begin
        DirecaoOrdem := CandleDirecao;
        PrecoAlvo := 0;
        OrdemArmada := true;

        if (CandleDirecao = 1) then
          NivelDisparo := High[1]
        else
          NivelDisparo := Low[1];
      end;
    end;
  end;

  if AlvoAtingidoNoDia then
  begin
    CancelPendingOrders;
  end
  else
  begin
    if HasPosition and (OrdemArmada = false) then
    begin
      if IsBought then
        PrecoAlvo := BuyPrice + AlvoPontos
      else if IsSold then
        PrecoAlvo := SellPrice - AlvoPontos;
    end;

    if OrdemArmada then
    begin
      CancelPendingOrders;

      if (DirecaoOrdem = 1) then
        BuyStop(QuantidadeAtual, NivelDisparo)
      else if (DirecaoOrdem = -1) then
        SellShortStop(QuantidadeAtual, NivelDisparo);
    end;
  end;
end;
