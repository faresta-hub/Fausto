Input
  AlvoPontos(50);
  QuantidadeInicial(1);
  MaxQuantidade(16);

Var
  DataReferencia : Integer;
  UltimoCandleProcessado : Integer;
  CandleDirecao : Integer;
  QuantidadeAtual : Integer;
  NivelDisparo : Float;
  PrecoAlvo : Float;
  DirecaoOrdem : Integer;
  PosicaoAtual : Integer;
  PosicaoAtualInicial : Integer;
  PosicaoAnterior : Integer;
  ResultadoPosicaoAberta : Float;
  ReverteuNesteCandle : Boolean;
  OrdemArmada : Boolean;
  FechamentoPorReversao : Boolean;

begin
  PosicaoAtualInicial := 0;

  if IsBought then
    PosicaoAtualInicial := 1
  else if IsSold then
    PosicaoAtualInicial := -1;

  if (Date <> DataReferencia) then
  begin
    DataReferencia := Date;
    UltimoCandleProcessado := CurrentBar - 1;
    CandleDirecao := 0;
    
    if (QuantidadeInicial > MaxQuantidade) then
      QuantidadeAtual := MaxQuantidade
    else
      QuantidadeAtual := QuantidadeInicial;
    NivelDisparo := 0;
    PrecoAlvo := 0;
    DirecaoOrdem := 0;
    PosicaoAnterior := PosicaoAtualInicial;
    ResultadoPosicaoAberta := 0;
    ReverteuNesteCandle := false;
    OrdemArmada := false;
    FechamentoPorReversao := false;

    CancelPendingOrders;

    if HasPosition then
      ClosePosition;
  end;

  PosicaoAtual := 0;

  if IsBought then
    PosicaoAtual := 1
  else if IsSold then
    PosicaoAtual := -1;

  if (PosicaoAnterior <> 0) and (PosicaoAtual = 0) then
  begin
    PrecoAlvo := 0;
    FechamentoPorReversao := false;
  end;

  if OrdemArmada and (PosicaoAnterior = 0) and (PosicaoAtual <> 0) then
  begin
    OrdemArmada := false;

    if IsBought then
      PrecoAlvo := BuyPrice + AlvoPontos
    else if IsSold then
      PrecoAlvo := SellPrice - AlvoPontos;
  end;

  if (CurrentBar > 0) and (CurrentBar <> UltimoCandleProcessado) then
  begin
    UltimoCandleProcessado := CurrentBar;
    CandleDirecao := 0;
    ReverteuNesteCandle := false;

    if not HasPosition then
    begin
      CancelPendingOrders;
      OrdemArmada := false;
    end;

    if (Close > Open) then
      CandleDirecao := 1
    else if (Close < Open) then
      CandleDirecao := -1;

    if (CandleDirecao <> 0) then
    begin
      if IsBought and (CandleDirecao = -1) then
      begin
        FechamentoPorReversao := true;
        ResultadoPosicaoAberta := OpenResult;
        ReverteuNesteCandle := true;
        ClosePosition;
        PrecoAlvo := 0;
        DirecaoOrdem := -1;
        NivelDisparo := Low;
        OrdemArmada := true;
      end
      else if IsSold and (CandleDirecao = 1) then
      begin
        FechamentoPorReversao := true;
        ResultadoPosicaoAberta := OpenResult;
        ReverteuNesteCandle := true;
        ClosePosition;
        PrecoAlvo := 0;
        DirecaoOrdem := 1;
        NivelDisparo := High;
        OrdemArmada := true;
      end;

      if ReverteuNesteCandle and (ResultadoPosicaoAberta < 0) then
      begin
        if (QuantidadeAtual > (MaxQuantidade / 2)) then
          QuantidadeAtual := MaxQuantidade
        else
          QuantidadeAtual := QuantidadeAtual * 2;
      end;

      if (PosicaoAtual = 0) and (not OrdemArmada) then
      begin
        DirecaoOrdem := CandleDirecao;
        PrecoAlvo := 0;
        OrdemArmada := true;

        if (CandleDirecao = 1) then
          NivelDisparo := High
        else
          NivelDisparo := Low;
      end;
    end;
  end;

  if HasPosition and (PrecoAlvo <> 0) then
  begin
    CancelPendingOrders;

    if IsBought then
      SellShortLimit(PrecoAlvo, QuantidadeAtual)
    else if IsSold then
      BuyToCoverLimit(PrecoAlvo, QuantidadeAtual);
  end
  else if OrdemArmada then
  begin
    CancelPendingOrders;

    if (DirecaoOrdem = 1) then
      BuyStop(NivelDisparo, QuantidadeAtual)
    else if (DirecaoOrdem = -1) then
      SellShortStop(NivelDisparo, QuantidadeAtual);
  end;

  PosicaoAnterior := PosicaoAtual;
end;
