// primeiro_candle_cor.src
// Indicador: pinta o primeiro candle do dia de verde (positivo) ou vermelho (negativo).
// O primeiro candle e detectado quando a data do candle atual difere da data do candle anterior.

Var
  prevDate : Integer;
  cOpen    : Float;
  cClose   : Float;

begin
  prevDate := Date[1];
  cOpen    := Open;
  cClose   := Close;

  if Date <> prevDate then
  begin
    if cClose > cOpen then
      PaintBar(clGreen)
    else if cClose < cOpen then
      PaintBar(clRed);
  end;

end;
